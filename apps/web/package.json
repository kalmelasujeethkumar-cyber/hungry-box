{
  "name": "@hungrybox/web",
  "version": "0.1.0",
  "private": true,
  "description": "Hungry Box frontend (single React + Vite + Tailwind application, role-based experiences later).",
  "type": "module",
  "scripts": {
    "predev": "tsc -p ../../packages/shared/tsconfig.build.json",
    "dev": "vite",
    "prebuild": "tsc -p ../../packages/shared/tsconfig.build.json",
    "build": "tsc --noEmit && vite build",
    "pretypecheck": "tsc -p ../../packages/shared/tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@hungrybox/shared": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
