{
  "name": "@hungrybox/api",
  "version": "0.1.0",
  "private": true,
  "description": "Hungry Box REST API (NestJS).",
  "scripts": {
    "predev": "tsc -p ../../packages/shared/tsconfig.build.json",
    "dev": "nest start --watch",
    "prebuild": "tsc -p ../../packages/shared/tsconfig.build.json && prisma generate",
    "build": "nest build",
    "pretypecheck": "tsc -p ../../packages/shared/tsconfig.build.json && prisma generate",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.seed.json --noEmit",
    "lint": "eslint .",
    "start:prod": "node dist/main.js",
    "test": "vitest run",
    "test:e2e": "vitest run test",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "provision:admin": "tsx scripts/provision-admin.ts",
    "provision:branch": "tsx scripts/provision-branch.ts"
  },
  "dependencies": {
    "@hungrybox/shared": "*",
    "@nestjs/common": "^12.0.4",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.4",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.0.4",
    "@nestjs/platform-socket.io": "^12.0.4",
    "@nestjs/websockets": "^12.0.4",
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.11.0",
    "pg": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.5",
    "@nestjs/schematics": "^12.0.4",
    "@nestjs/testing": "^12.0.4",
    "@types/express": "^5.0.0",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.0.0",
    "@types/supertest": "^7.2.1",
    "dotenv": "^16.0.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prisma": "^7.10.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
