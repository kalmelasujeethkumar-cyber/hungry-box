# Server
PORT=3000
API_PREFIX=api
NODE_ENV=development
SERVICE_NAME=hungrybox-api

# CORS - comma-separated origins allowed in the browser for both the HTTP API
# and the /realtime Socket.IO gateway (dev default below). The API refuses a
# wildcard "*" because credentials are always enabled; staging/production must
# list the exact frontend origin(s), e.g. https://app.hungrybox.example.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL - replace with your local/dev instance. Production values are
# supplied by Railway via its own env config, never committed here.
# Required by prisma generate/validate/migrate and by the API at runtime.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hungrybox

# Authentication
# JWT_SECRET must be set in production (the API refuses to start without it).
# Development falls back to a predictable local secret so a dev server can boot
# without an .env file; never rely on that default outside local development.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Checkout & payments
# The payment provider is an abstraction. Only the development/mock provider
# ("dev") ships in this phase. Setting an unknown id fails the API at boot, and
# "dev" is rejected when NODE_ENV=production (staging/demo deployments may keep
# it deliberately). A real gateway must be implemented before Hungry Box can
# process real money; Phase 9 makes deployment possible, NOT live payments.
PAYMENT_PROVIDER=dev
# Flat delivery fee in integer paise (default 30.00). A future phase can make
# this branch/distance/order-value aware; the fee is always snapshot on the order.
DELIVERY_FEE_MINOR=3000
# Explicit tax in integer paise. Default 0; no fictional GST is invented here.
CHECKOUT_TAX_MINOR=0

# Public catalog media (Cloudinary)
# Product & category images are uploaded to Cloudinary by SUPER_ADMIN. When these
# are absent, media management requests fail with a clear 503 and the API still
# boots so the rest of the app is not blocked. Never expose these to the frontend.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Provisioning (deliberate operator commands only, never run automatically) ---
# Used by `npm run provision:admin` (creates the initial SUPER_ADMIN or safely
# refuses conflicting state). Never run these through a frontend or the API.
# PROVISION_ADMIN_LOGIN_ID=change-me@example.com
# PROVISION_ADMIN_PASSWORD=replace-with-a-strong-password
# PROVISION_ADMIN_NAME=Super Admin
#
# Used by `npm run provision:branch` (creates the first branch from explicit
# values; never guessed or hard-coded). BRANCH_DELIVERY_RADIUS_KM is required.
# BRANCH_CODE=your-branch-code
# BRANCH_NAME=Hungry Box <City>
# BRANCH_CITY=City
# BRANCH_STATE=State
# BRANCH_COUNTRY=India
# BRANCH_ADDRESS=Street address
# BRANCH_LATITUDE=16.5062
# BRANCH_LONGITUDE=80.6480
# BRANCH_DELIVERY_RADIUS_KM=8